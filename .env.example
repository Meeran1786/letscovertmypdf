# LetsConvertPDF — Environment Configuration
# Copy this file to .env and fill in real values before starting the server.

PORT=3000
NODE_ENV=production

# Gmail SMTP (OTP + chat notification emails) — see PRD §9.3 for App Password setup
EMAIL_USER=
EMAIL_APP_PASSWORD=
ADMIN_EMAIL=

# Uploads
MAX_FILE_SIZE_MB=256

# Where accounts, sessions and usage counters are stored. Must survive
# redeploys — in Docker, mount a volume at this path.
DATA_DIR=/app/data

# Reverse proxy trust (Nginx/Caddy in front of Node = 1 hop; behind a CDN + LB, increase accordingly)
TRUST_PROXY=1

# Freemium usage limits (uses per tool per UTC day)
FREE_ANON_DAILY_LIMIT=1
FREE_USER_DAILY_LIMIT=3

# Rate limiting (per IP, per 15-minute window)
RATE_LIMIT_API_MAX=300
RATE_LIMIT_AUTH_MAX=20

# Google Sign-In (optional — the button shows "not set up yet" until this is set).
# Google Cloud Console → APIs & Services → Credentials → OAuth client ID →
# Web application → add https://letsconvertpdf.com (and https://www.letsconvertpdf.com
# if used) under "Authorized JavaScript origins". Only the Client ID is needed;
# it is public. No client secret is used by this flow.
GOOGLE_CLIENT_ID=

# Optional cloud import (files go from the provider straight to the browser).
# Google Drive: an API key restricted to the Google Picker API, plus GOOGLE_CLIENT_ID above.
GOOGLE_PICKER_API_KEY=
# Dropbox: create a "Chooser" app at https://www.dropbox.com/developers/apps and add your domain.
DROPBOX_APP_KEY=
